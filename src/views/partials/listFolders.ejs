<ul>
  <% folders.forEach(folder => { %>
    <li data-id="<%= folder.id %>" data-parent="<%= folder.parentId %>" class="folder-li">
      <a href="/folders/<%= folder.id %>">
        📁 <%= folder.name %>
      </a>

      <div class="dropdown-container" style="position: relative;">
        <svg class="menu-toggle" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#000000" viewBox="0 0 256 256"><path d="M128,96a32,32,0,1,0,32,32A32,32,0,0,0,128,96Zm0,48a16,16,0,1,1,16-16A16,16,0,0,1,128,144Zm0-64A32,32,0,1,0,96,48,32,32,0,0,0,128,80Zm0-48a16,16,0,1,1-16,16A16,16,0,0,1,128,32Zm0,144a32,32,0,1,0,32,32A32,32,0,0,0,128,176Zm0,48a16,16,0,1,1,16-16A16,16,0,0,1,128,224Z"></path></svg>
        <div class="dropdown hidden">
          <button class="edit-btn">Edit</button>
          <button class="delete-btn">Delete</button>
        </div>
      </div>
    </li>
  <% }) %>
</ul>
